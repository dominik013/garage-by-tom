---
import Layout from '../layouts/Layout.astro';
import { location, openingHours } from '../data/site';
---
<Layout title="Anfahrt & Öffnungszeiten" description="Dein Weg zur garage by tom: Stadtplatz 57, 5230 Mattighofen. Adresse, Routenplanung und interaktive Karte.">
 <section class="menu-hero container arrival-hero"><a class="back-link" href="/">Zurück zur garage</a><div class="arrival-hero-grid"><div><div class="eyebrow orange">ANFAHRT &amp; ÖFFNUNGSZEITEN</div><h1>ALLE WEGE.<br/><span class="orange">EINE GARAGE.</span></h1><div class="menu-intro"><p>Mit zwei Rädern, vier Rädern oder zu Fuß.<br/>Wir freuen uns, wenn dein Weg bei uns vorbeiführt.</p></div></div><aside class="opening-hours" aria-labelledby="hours-title"><span class="eyebrow orange">ZEIT FÜR DIE GARAGE</span><h2 id="hours-title">ÖFFNUNGSZEITEN.</h2><dl>{openingHours.map(row=><div><dt>{row.days}</dt><dd>{row.hours}</dd></div>)}</dl></aside></div></section>
 <section class="light"><div class="container section-pad arrival-grid"><div><span class="eyebrow">HIER FINDEST DU UNS</span><h2>MITTEN IN<br/>MATTIGHOFEN.</h2></div><div class="arrival-address"><p class="location-title">garage by tom</p><address>{location.street}<br/>{location.city}</address><p>Direkt an der KTM Motohall.</p><a class="button button-dark" href={location.directions} target="_blank" rel="noopener noreferrer">Navigation starten</a></div></div>
 <div class="container map-section"><div class="map-heading"><span class="eyebrow">DEIN ZIEL AUF DER KARTE</span><a class="text-link" href={location.map} target="_blank" rel="noopener noreferrer">Karte groß öffnen</a></div><div class="map-frame" id="map-frame"><div id="location-map" role="region" aria-label="Interaktive Karte: garage by tom, Stadtplatz 57 in Mattighofen" data-lat={location.latitude} data-lng={location.longitude}><p class="map-loading" role="status">Karte wird geladen …</p></div><noscript><p class="map-no-script">Die interaktive Karte benötigt JavaScript. <a href={location.map}>Standort auf Google Maps öffnen </a></p></noscript></div><p class="map-caption">Stadtplatz 57 · 5230 Mattighofen · Kartendaten © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap-Mitwirkende</a></p></div></section>
 <section class="visit" id="bis-bald"><div class="container section-pad visit-grid"><div><span class="eyebrow">BIS BALD IN DER GARAGE</span><h2>DEIN PLATZ<br/>BEI UNS.</h2></div><div class="visit-info"><p class="location-title">Wir machen Platz für dich.</p><p>Für eine kurze Pause, einen langen Abend oder eine gute Zeit mit deinen Lieblingsmenschen.</p><a class="text-link" href="/tagesmenue/">Schon mal Appetit holen</a></div></div></section>
 <script is:inline src="/location-map.js" defer></script>
</Layout>
