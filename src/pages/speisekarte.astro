---
import Layout from '../layouts/Layout.astro';
import { categories } from '../data/menu';
const nav = categories.map(c=>({id:c.id,title:c.title}));
---
<Layout title="Speisekarte" description="Die Speisekarte der garage by tom: Warm-up, Suppen, grüne Gerichte, Hauptrennen, Beilagen, Desserts.">
 <section class="menu-hero container"><a class="back-link" href="/">Zurück zur garage</a><div class="eyebrow orange">SPEISEKARTE</div><h1>GUTER HUNGER.<br/><span class="orange">GUTE AUSSICHTEN.</span></h1><div class="menu-intro"><p>Ein kleines Warm-up? Das volle Hauptrennen?<br/>Such dir aus, worauf du Lust hast.</p></div></section>
 <div class="menu-surface"><div class="container menu-layout">
  <aside class="menu-sidebar"><span class="eyebrow">WORAUF HAST DU LUST?</span><nav aria-label="Speisekarten-Kategorien">{nav.map((c,i)=><a href={`#${c.id}`}><span>{String(i+1).padStart(2,'0')}</span>{c.title}</a>)}</nav><span class="menu-currency">Alle Preise in Euro.</span></aside>
  <details class="category-picker"><summary>Direkt zur Kategorie <span aria-hidden="true">↓</span></summary><nav aria-label="Speisekarten-Kategorien mobil">{nav.map(c=><a href={`#${c.id}`}>{c.title}</a>)}</nav></details>
  <div class="menu-content">
   {!categories.length && <p>Unsere aktuelle Speisekarte findest du in Kürze hier.</p>}
   {categories.map((category,i)=><section class="menu-category" id={category.id} aria-labelledby={`title-${category.id}`}><div class="category-title"><span class="eyebrow">{String(i+1).padStart(2,'0')} /</span><h2 id={`title-${category.id}`}>{category.title}</h2></div><ul class="dish-list">{category.dishes.map(dish=><li class="dish"><div class="dish-heading"><h3>{dish.name}</h3><span class:list={['dish-price',{'price-pending':dish.price===null}]}>{dish.price ? `${dish.price} €`:'Preis auf Anfrage'}</span></div><p>{dish.description}</p></li>)}</ul></section>)}
   <section class="daily-menu-link" id="mittag"><span class="eyebrow">LUST AUF MITTAG?</span><h2>DEINE PAUSE. DEIN MENÜ.</h2><p>Die Menüs von Montag bis Freitag findest du auf unserer Tagesmenü-Seite.</p><a class="button button-dark" href="/tagesmenue/">Zum Tagesmenü</a></section>
   <div class="menu-end"><p>Manches bleibt offen. Der Appetit hoffentlich nicht.</p><a class="text-link" href="/anfahrt/">Hier findest du uns</a><span>Alle Preise in Euro.</span></div>
  </div>
 </div></div>
 <script>
  const picker=document.querySelector<HTMLDetailsElement>('.category-picker');
  picker?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{picker.open=false;}));
  const links=document.querySelectorAll<HTMLAnchorElement>('.menu-sidebar a');
  if('IntersectionObserver' in window){
   const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){const id=entry.target.closest('.menu-category')?.id;links.forEach(a=>{if(a.hash===`#${id}`)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});}});},{rootMargin:'-110px 0px -65% 0px'});
   document.querySelectorAll('.category-title').forEach(heading=>observer.observe(heading));
  }
 </script>
</Layout>
